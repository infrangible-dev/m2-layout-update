{
    "name": "infrangible/m2-layout-update",
    "description": "Groundwork that lets other Infrangible modules adjust page layout elements, such as CSS classes, depending on configuration settings.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Developer tools"
    ],
    "homepage": "https://www.infrangible.dev/modules/layout-update",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-filter": "*",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\LayoutUpdate\\": "src"
        }
    }
}
